{
  "name": "dentalapp",
  "version": "1.0.0",
  "description": "Diş klinikleri ile laboratuvar arasındaki vaka, tasarım, onay, üretim ve teslim süreçlerini yöneten demo uygulaması.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --names FIREBASE,MAIL,API,WORKER,MESH,BEAT,WEB --prefix-colors yellow,white,cyan,magenta,red,blue,green --kill-others-on-fail \"npm:dev:firebase\" \"npm:dev:mail\" \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:mesh-worker\" \"npm:dev:beat\" \"npm:dev:web\"",
    "dev:firebase": "firebase emulators:start --only auth --import=./firebase-export --export-on-exit --project dentalapp-7b131",
    "dev:mail": "node scripts/dev-mail.mjs",
    "dev:api": "backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --reload-dir backend --app-dir backend",
    "dev:worker": "backend\\.venv\\Scripts\\python.exe -m celery --workdir backend -A app.worker.celery_app worker --pool=solo --queues=default --hostname=default@%h --loglevel=INFO",
    "dev:mesh-worker": "backend\\.venv\\Scripts\\python.exe -m celery --workdir backend -A app.worker.celery_app worker --pool=solo --queues=mesh --hostname=mesh@%h --loglevel=INFO",
    "dev:beat": "backend\\.venv\\Scripts\\python.exe -m celery --workdir backend -A app.worker.celery_app beat --loglevel=INFO --schedule ../storage/celerybeat-schedule",
    "dev:web": "npm --prefix frontend run dev",
    "test": "npm run test:backend && npm run test:frontend",
    "test:quick": "npm run test:backend:unit && npm run test:frontend",
    "test:backend": "npm run test:backend:unit && npm run test:backend:integration",
    "test:backend:unit": "backend\\.venv\\Scripts\\python.exe -m pytest -c backend\\pyproject.toml backend\\tests -m \"not integration\"",
    "test:backend:integration": "set RUN_DATABASE_INTEGRATION_TESTS=1&& backend\\.venv\\Scripts\\python.exe -m pytest -c backend\\pyproject.toml backend\\tests -m integration",
    "test:backend:firebase": "node scripts/verify-firebase.mjs",
    "test:frontend": "npm --prefix frontend test",
    "lint": "backend\\.venv\\Scripts\\python.exe -m ruff check backend && npm --prefix frontend run lint",
    "build": "npm --prefix frontend run build",
    "verify": "npm test && npm run lint && npm run build",
    "verify:full": "npm run verify && npm run test:backend:firebase",
    "security:audit": "backend\\.venv\\Scripts\\python.exe -m pip_audit -r backend\\requirements.lock && npm --prefix frontend audit --omit=dev",
    "storage:check": "backend\\.venv\\Scripts\\python.exe -m app.cli.check_storage",
    "firebase:user:repair": "backend\\.venv\\Scripts\\python.exe -m app.cli.repair_emulator_user",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\backup.ps1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YSTuran/DentalApp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/YSTuran/DentalApp/issues"
  },
  "homepage": "https://github.com/YSTuran/DentalApp#readme",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "firebase-tools": "^15.30.2"
  }
}
