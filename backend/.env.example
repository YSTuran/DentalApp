APP_NAME=DentalApp API
APP_ENV=development
APP_DEBUG=true
DEMO_MODE=true
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://dentalapp_user:change-me@localhost:5432/dentalapp
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-this-before-real-use
CORS_ORIGINS=["http://localhost:5173"]
STORAGE_PATH=../storage
FIREBASE_PROJECT_ID=demo-dentalapp
FIREBASE_CREDENTIALS_PATH=C:/Users/username/.secrets/dentalapp/firebase-admin.json
FIREBASE_USE_EMULATOR=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_SESSION_DAYS=5
FIREBASE_SESSION_COOKIE_NAME=dentalapp_session
CSRF_COOKIE_NAME=dentalapp_csrf
COOKIE_SECURE=false
